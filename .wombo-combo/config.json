{
  "devMode": true,
  "tasksDir": "tasks",
  "archiveDir": "archive",
  "baseBranch": "main",
  "build": {
    "command": "bun run build",
    "timeout": 300000,
    "artifactDir": "dist"
  },
  "install": {
    "command": "bun install",
    "timeout": 120000
  },
  "git": {
    "branchPrefix": "feature/",
    "worktreePrefix": "wt-wombo-",
    "remote": "origin",
    "mergeStrategy": "--no-ff"
  },
  "agent": {
    "bin": null,
    "name": "generalist-agent",
    "configFiles": [
      ".opencode/",
      "opencode.json",
      "AGENTS.md"
    ],
    "tmuxPrefix": "wombo-combo"
  },
  "portless": {
    "enabled": true,
    "bin": null,
    "proxyPort": 1355,
    "https": true
  },
  "backup": {
    "maxBackups": 5
  },
  "defaults": {
    "maxConcurrent": 3,
    "maxRetries": 2
  },
  "browser": {
    "enabled": false,
    "bin": null,
    "headless": true,
    "testCommand": null,
    "launchTimeout": 30000,
    "testTimeout": 60000,
    "defaultViewport": {
      "width": 1280,
      "height": 720
    }
  },
  "agentRegistry": {
    "mode": "auto",
    "source": "msitarzewski/agency-agents",
    "cacheDir": "agents-cache"
  },
  "tdd": {
    "enabled": true,
    "testCommand": "CI=true bun test --timeout 30000 --path-ignore-patterns 'tests/e2e/**'",
    "strictTdd": true,
    "testTimeout": 900000
  },
  "postMerge": {
    "prMode": "skip",
    "prBaseBranch": null,
    "changelog": true
  },
  "agentProfiles": {
    "claude-local": {
      "harness": "claude-code",
      "args": [
        "--allowedTools=Bash,Edit,Write,Read,Glob,Grep"
      ]
    },
    "antigravity": {
      "harness": "antigravity",
      "model": "claude-sonnet-4-6"
    }
  },
  "routing": {
    "default": "claude-local",
    "byOperation": {
      "code": "antigravity"
    }
  },
  "sync": {
    "github": {
      "enabled": true,
      "mode": "manual"
    }
  },
  "tui": {
    "theme": "default",
    "locale": "auto",
    "checkForUpdates": true,
    "autoInstallUpdates": false
  },
  "modelRouting": {
    "light": null,
    "medium": null,
    "heavy": null
  }
}
