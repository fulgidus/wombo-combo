{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/fulgidus/wombo/schemas/config.schema.json",
  "title": "wombo-combo Configuration",
  "description": "Schema for .wombo-combo/config.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference (for editor validation)"
    },
    "tasksDir": {
      "type": "string",
      "default": "tasks",
      "description": "Directory name for task files relative to .wombo-combo/"
    },
    "archiveDir": {
      "type": "string",
      "default": "archive",
      "description": "Directory name for archived task files relative to .wombo-combo/"
    },
    "tasksFile": {
      "type": "string",
      "description": "DEPRECATED: Legacy single-file path. Use tasksDir instead."
    },
    "archiveFile": {
      "type": "string",
      "description": "DEPRECATED: Legacy single-file path. Use archiveDir instead."
    },
    "baseBranch": {
      "type": "string",
      "default": "main",
      "description": "Base branch to create feature branches from"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "default": "npm run build",
          "description": "Build command to run in worktrees"
        },
        "timeout": {
          "type": "integer",
          "default": 300000,
          "description": "Build timeout in milliseconds"
        },
        "artifactDir": {
          "type": "string",
          "default": "dist",
          "description": "Build artifact directory"
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "default": "npm install",
          "description": "Install command to run in worktrees"
        },
        "timeout": {
          "type": "integer",
          "default": 120000,
          "description": "Install timeout in milliseconds"
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branchPrefix": {
          "type": "string",
          "default": "feature/",
          "description": "Branch name prefix for feature branches"
        },
        "worktreePrefix": {
          "type": "string",
          "default": "woco-",
          "description": "Worktree directory name prefix"
        },
        "remote": {
          "type": "string",
          "default": "origin",
          "description": "Git remote name"
        },
        "mergeStrategy": {
          "type": "string",
          "default": "--no-ff",
          "description": "Merge strategy flag (e.g. --no-ff, --ff-only)"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bin": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Path to agent binary (null = auto-detect)"
        },
        "name": {
          "type": "string",
          "default": "generalist-agent",
          "description": "Agent name to pass via --agent flag"
        },
        "configFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".opencode/",
            "opencode.json",
            "AGENTS.md"
          ],
          "description": "Config files/dirs to copy into worktrees"
        },
        "tmuxPrefix": {
          "type": "string",
          "default": "wombo-combo",
          "description": "Session name prefix for tmux"
        }
      }
    },
    "portless": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether portless is enabled for agent worktrees"
        },
        "bin": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Path to portless binary (null = auto-detect)"
        },
        "proxyPort": {
          "type": "integer",
          "default": 1355,
          "description": "Proxy port (portless default is 1355)"
        },
        "https": {
          "type": "boolean",
          "default": false,
          "description": "Whether to use HTTPS mode"
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxBackups": {
          "type": "integer",
          "default": 5,
          "minimum": 0,
          "description": "Maximum number of timestamped backups to keep"
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxConcurrent": {
          "type": "integer",
          "default": 10,
          "minimum": 0,
          "description": "Max concurrent agents (0 = unlimited)"
        },
        "maxRetries": {
          "type": "integer",
          "default": 5,
          "minimum": 0,
          "description": "Max retries per agent"
        }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable browser testing in the verify pipeline"
        },
        "bin": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Path to browser binary (null = auto-detect)"
        },
        "headless": {
          "type": "boolean",
          "default": true,
          "description": "Run browser in headless mode"
        },
        "testCommand": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Custom test command for browser tests"
        },
        "launchTimeout": {
          "type": "integer",
          "default": 30000,
          "description": "Timeout for launching a browser instance (ms)"
        },
        "testTimeout": {
          "type": "integer",
          "default": 60000,
          "description": "Timeout for each browser test script (ms)"
        },
        "defaultViewport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "default": 1280
            },
            "height": {
              "type": "integer",
              "default": 720
            }
          }
        }
      }
    },
    "agentRegistry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "monitored",
            "disabled"
          ],
          "default": "auto",
          "description": "Agent registry download mode"
        },
        "source": {
          "type": "string",
          "default": "msitarzewski/agency-agents",
          "description": "GitHub repo for agent registry"
        },
        "cacheDir": {
          "type": "string",
          "default": "agents-cache",
          "description": "Local cache directory for downloaded agents"
        }
      }
    },
    "tdd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable TDD verification in the build pipeline"
        },
        "testCommand": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Test command to run (e.g. 'bun test', 'npm test')"
        },
        "testTimeout": {
          "type": "integer",
          "default": 120000,
          "description": "Timeout for test execution in milliseconds"
        },
        "strictMode": {
          "type": "boolean",
          "default": false,
          "description": "When true, any test failure blocks verification"
        }
      }
    },
    "postMerge": {
      "type": "object",
      "additionalProperties": false,
      "description": "Changelog generation and GitHub PR publication after successful merges",
      "properties": {
        "prMode": {
          "type": "string",
          "enum": [
            "open",
            "draft",
            "skip"
          ],
          "default": "skip",
          "description": "open = ready PR, draft = draft PR, skip = no GitHub publication"
        },
        "prBaseBranch": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "default": null,
          "description": "PR target branch; null = the configured remote's default branch"
        },
        "changelog": {
          "type": "boolean",
          "default": true,
          "description": "Append a CHANGELOG.md entry after successful merges (independent of prMode)"
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "description": "Retention of recorded agent session replays (.wombo-combo/replays/), applied after each execution finishes",
      "properties": {
        "keepPerTask": {
          "type": "integer",
          "minimum": 0,
          "default": 20,
          "description": "Executions kept per task (newest first)"
        },
        "maxAgeDays": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "default": null,
          "description": "Delete replays older than this many days; null = no age limit"
        },
        "maxTotalMB": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "default": null,
          "description": "Total size cap of all replays in MB (oldest removed first); null = no cap"
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "description": "Multi-developer coordination: git-tracked task claims (.wombo-combo/claims/) so teammates do not work on the same task",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable task claims; the daemon skips tasks claimed by another developer"
        },
        "owner": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "default": null,
          "description": "Claim owner identity; null = git config user.email"
        },
        "claimTtlHours": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 24,
          "description": "Hours until a claim expires and can be taken over"
        }
      }
    },
    "comments": {
      "type": "object",
      "additionalProperties": false,
      "description": "Task and quest comments (.wombo-combo/comments/): recent comments in agent prompts and optional daemon lifecycle comments",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Include recent comments in agent prompts and tell agents how to leave one"
        },
        "promptMaxItems": {
          "type": "integer",
          "minimum": 1,
          "default": 10,
          "description": "Maximum number of recent comments per task or quest in the agent prompt"
        },
        "promptMaxChars": {
          "type": "integer",
          "minimum": 1,
          "default": 4000,
          "description": "Maximum total characters of comment text in the agent prompt (oldest dropped first)"
        },
        "autoLifecycle": {
          "type": "boolean",
          "default": false,
          "description": "Daemon posts system comments on task lifecycle events (started, failed, merged, retried)"
        }
      }
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "description": "Integrations that sync woco data with external services",
      "properties": {
        "github": {
          "type": "object",
          "additionalProperties": false,
          "description": "GitHub issue sync (woco sync): tasks, quests and comments as issues. Manual commands always work; mode auto adds write-through pushes and periodic pull+push cycles",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Master switch for the automatic behaviour (write-through push, daemon cycle)"
            },
            "mode": {
              "type": "string",
              "enum": ["manual", "auto"],
              "default": "manual",
              "description": "manual: only explicit woco sync commands. auto: push changed items right after they are written, and run pull+push every intervalSeconds in the daemon"
            },
            "repo": {
              "type": ["string", "object"],
              "description": "Repository to sync with, as \"owner/name\" or { owner, name, host }. Default: the git origin remote"
            },
            "intervalSeconds": {
              "type": "number",
              "minimum": 15,
              "default": 60,
              "description": "Seconds between automatic pull+push cycles (daemon and woco sync watch)"
            },
            "pushOnWrite": {
              "type": "boolean",
              "default": true,
              "description": "In auto mode, push an item in the background right after a local change to it"
            },
            "pull": {
              "type": "boolean",
              "default": true,
              "description": "In auto mode, cycles also pull remote changes before pushing"
            },
            "includeFinished": {
              "type": "boolean",
              "default": false,
              "description": "Also mirror finished work that has no mapping yet (done/cancelled tasks, completed/abandoned quests, closed issues). Already-mapped items keep syncing either way"
            }
          }
        }
      }
    },
    "devMode": {
      "type": "boolean",
      "default": false,
      "description": "Developer mode: enables hidden features like fake task seeding (F key) in TUI. Can also be enabled via --dev CLI flag."
    },
    "modelRouting": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-task model routing by weight class (light/medium/heavy); null/absent = session model",
      "properties": {
        "light": {
          "type": [
            "string",
            "null"
          ]
        },
        "medium": {
          "type": [
            "string",
            "null"
          ]
        },
        "heavy": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "agentProfiles": {
      "type": "object",
      "description": "Named agent profiles: harness + binary + model + provider + account env references. Never put secrets here.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "harness"
        ],
        "properties": {
          "harness": {
            "type": "string",
            "enum": [
              "opencode",
              "claude-code",
              "codex",
              "pi",
              "custom"
            ],
            "description": "Which CLI adapter runs this profile"
          },
          "bin": {
            "type": [
              "string",
              "null"
            ],
            "description": "Executable path or name; null = harness default"
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "description": "Model passed to the CLI"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ],
            "description": "Provider passed to the CLI (where supported)"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Extra CLI arguments placed before the prompt"
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Literal NON-secret environment variables (secret-looking keys/values are rejected)"
          },
          "envFrom": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "description": "Child env var -> NAME of a variable in wombo's environment (account/API key routing)"
          },
          "account": {
            "type": "string",
            "description": "Free-form account label"
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            },
            "description": "Override adapter capability flags"
          },
          "command": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "args"
            ],
            "description": "Command template for harness custom",
            "properties": {
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Placeholders: {prompt} {model} {provider} {cwd} {agent} {title}"
              },
              "resumeArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Resume template; adds {session}"
              },
              "output": {
                "type": "string",
                "enum": [
                  "text",
                  "opencode-jsonl"
                ],
                "default": "text"
              },
              "stdin": {
                "type": "boolean",
                "default": false
              }
            }
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "description": "Which profile handles which task weight, difficulty or operation, with fallback chains",
      "properties": {
        "default": {
          "type": "string",
          "minLength": 1,
          "description": "Name of a profile defined in agentProfiles"
        },
        "byWeight": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "light": {
              "type": "string",
              "minLength": 1,
              "description": "Name of a profile defined in agentProfiles"
            },
            "medium": {
              "type": "string",
              "minLength": 1,
              "description": "Name of a profile defined in agentProfiles"
            },
            "heavy": {
              "type": "string",
              "minLength": 1,
              "description": "Name of a profile defined in agentProfiles"
            }
          }
        },
        "byDifficulty": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trivial": {
              "type": "string",
              "minLength": 1,
              "description": "Name of a profile defined in agentProfiles"
            },
            "easy": {
              "type": "string",
              "minLength": 1,
              "description": "Name of a profile defined in agentProfiles"
            },
            "medium": {
              "type": "string",
              "minLength": 1,
              "description": "Name of a profile defined in agentProfiles"
            },
            "hard": {
              "type": "string",
              "minLength": 1,
              "description": "Name of a profile defined in agentProfiles"
            },
            "very_hard": {
              "type": "string",
              "minLength": 1,
              "description": "Name of a profile defined in agentProfiles"
            }
          }
        },
        "byOperation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plan": {
              "type": "string",
              "minLength": 1,
              "description": "Name of a profile defined in agentProfiles"
            },
            "code": {
              "type": "string",
              "minLength": 1,
              "description": "Name of a profile defined in agentProfiles"
            },
            "conflict": {
              "type": "string",
              "minLength": 1,
              "description": "Name of a profile defined in agentProfiles"
            },
            "review": {
              "type": "string",
              "minLength": 1,
              "description": "Name of a profile defined in agentProfiles"
            }
          }
        },
        "fallbacks": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Name of a profile defined in agentProfiles"
            }
          },
          "description": "profile -> ordered fallback profiles tried when it cannot start"
        }
      }
    }
  }
}
