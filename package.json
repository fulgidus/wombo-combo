{
    "name": "wombo-combo",
    "version": "0.9.0",
    "description": "WOMBO COMBO! — AI agent orchestration system for parallel feature development",
    "type": "module",
    "bin": {
        "woco": "./src/index.ts"
    },
    "files": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/templates/**",
        "src/locales/**",
        "schemas/**"
    ],
    "scripts": {
        "dev": "bun src/index.ts",
        "woco": "bun src/index.ts",
        "start": "bun src/index.ts",
        "build": "bun scripts/build.ts",
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "docs:gen": "bun scripts/gen-command-docs.ts && bun scripts/gen-config-docs.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fulgidus/wombo-combo.git"
    },
    "homepage": "https://github.com/fulgidus/wombo-combo",
    "bugs": {
        "url": "https://github.com/fulgidus/wombo-combo/issues"
    },
    "keywords": [
        "ai",
        "agent",
        "orchestration",
        "parallel",
        "feature-development",
        "cli",
        "wombo-combo",
        "woco"
    ],
    "author": "fulgidus",
    "license": "MIT",
    "engines": {
        "bun": ">=1.0.0"
    },
    "dependencies": {
        "citty": "^0.2.1",
        "i18next": "26.4.2",
        "ink": "^6.8.0",
        "mermaidtui": "^0.0.5",
        "react": "^19.2.4",
        "yaml": "^2.7.1"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/react": "^19.2.14",
        "typescript": "^5.8.2"
    }
}